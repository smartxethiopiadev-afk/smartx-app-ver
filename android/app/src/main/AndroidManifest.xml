<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.smartx.learning">
    
    <!-- ======================================================================= -->
    <!-- PERMISSIONS & SYSTEM SECURITY COVENANTS                                 -->
    <!-- ======================================================================= -->
    <!-- Essential internet connectivity for app content retrieval -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Network telemetry to detect active connections for offline warning sync -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/LaunchTheme"
        android:allowBackup="true"
        android:supportsRtl="true">
        
        <!-- ======================================================================= -->
        <!-- ADVERTISING METADATA CONTEXT                                            -->
        <!-- ======================================================================= -->
        <!-- Google Mobile Ads SDK (AdMob) ID mapping -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"/>

        <!-- ======================================================================= -->
        <!-- MAIN LAUNCHER ENTRY POINT                                               -->
        <!-- ======================================================================= -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            
            <!-- normalTheme tells Flutter to swap from LaunchTheme back to NormalTheme -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"/>
              
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        
        <!-- Flutter Engine registration and plugin binding mechanism -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
