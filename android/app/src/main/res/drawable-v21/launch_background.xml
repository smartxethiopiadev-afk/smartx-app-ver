<?xml version="1.0" encoding="utf-8"?>
<!-- Android Native Splash Screen for Smart Learn Ethiopia -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Seamless background matching the Flutter splash screen dark theme (#080E1E) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#080E1E" />
        </shape>
    </item>
    
    <!-- Centered application circular icon with proper scale -->
    <item
        android:drawable="@mipmap/ic_launcher_round"
        android:gravity="center"
        android:width="170dp"
        android:height="170dp" />
</layer-list>

