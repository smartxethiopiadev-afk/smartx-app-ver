<?xml version="1.0" encoding="utf-8"?>
<!-- Android Native Splash Screen for Smart Learn Ethiopia -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Seamless dark background (#080E1E) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#080E1E" />
        </shape>
    </item>
    
    <!-- Circular background badge ensuring the icon displays as a clean circle -->
    <item
        android:gravity="center"
        android:width="160dp"
        android:height="160dp">
        <shape android:shape="oval">
            <solid android:color="#0F172A" />
            <stroke
                android:width="2.5dp"
                android:color="#0284C7" />
        </shape>
    </item>

    <!-- Centered application icon with proper scale -->
    <item
        android:gravity="center"
        android:width="140dp"
        android:height="140dp">
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>

