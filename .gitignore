# ==============================================================================
# Comprehensive Flutter & Android .gitignore Configuration
# Protects all sensitive credentials, keystores, and local environment files
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CRITICAL SECURITY & SENSITIVE CREDENTIALS (DO NOT COMMIT)
# ------------------------------------------------------------------------------
*.keystore
*.jks
*.p12
*.bks
*.pfx
**/my-release-key.keystore
**/upload-keystore.jks

# Keystore properties and signing configs
key.properties
**/key.properties
key.properties.local

# Google Services / Firebase API Configuration files
google-services.json
**/google-services.json
GoogleService-Info.plist
**/GoogleService-Info.plist

# Local environment & secret variables
.env
.env.*
.env.local
.env.production
.env.staging
!.env.example

# Local Android SDK and properties
local.properties
**/local.properties
**/android/local.properties

# ------------------------------------------------------------------------------
# 2. FLUTTER & DART BUILD ARTIFACTS
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
pubspec.lock
build/
/build/
**/doc/api/
.symbols/

# ------------------------------------------------------------------------------
# 3. ANDROID GRADLE BUILD OUTPUTS & CACHES
# ------------------------------------------------------------------------------
.gradle/
**/android/.gradle/
**/android/captures/
**/android/**/GeneratedPluginRegistrant.java
**/android/**/generated/
**/android/**/build/
**/android/app/build/
**/android/.cxx/

# Gradle wrapper binaries
**/android/**/gradle-wrapper.jar
**/android/gradlew
**/android/gradlew.bat

# ------------------------------------------------------------------------------
# 4. IOS / MACOS ARTIFACTS
# ------------------------------------------------------------------------------
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*
**/ios/Pods/
**/ios/.symlinks/
**/ios/profile
**/ios/Podfile.lock
**/ios/**/default.mode1v3
**/ios/**/default.mode2v3
**/ios/**/default.pbxuser
**/ios/**/default.perspectivev3

# ------------------------------------------------------------------------------
# 5. IDE & SYSTEM ARTIFACTS
# ------------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.code-workspace
.history
.atom/
.svn/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.log
*.class
*.pyc
*.swp
*.bak
*.tmp
.buildlog/
migrate_working_dir/

# ------------------------------------------------------------------------------
# 6. LOCAL WEB PREVIEW & DEMO ONLY FILES (Kept local, excluded from Mobile Git)
# ------------------------------------------------------------------------------
web/
/web/
/src/
src/
node_modules/
dist/
bun.lock
package.json
package-lock.json
tsconfig.json
vite.config.ts
index.html
metadata.json
.aistudio/
server.ts
server.js
*.ts
*.map
